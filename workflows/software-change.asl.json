{
  "Comment": "Proposed Service Line workflow. Custom resources require an unimplemented runtime; this file is not an executable integration.",
  "StartAt": "Initialize",
  "States": {
    "Initialize": {
      "Type": "Pass",
      "Result": 0,
      "ResultPath": "$.repairs",
      "Next": "Plan"
    },
    "Plan": {
      "Comment": "The plan includes a risk level (low, medium, high) with reasons. Approval binds it.",
      "Type": "Task",
      "Resource": "service-line:agent.plan",
      "ResultPath": "$.plan",
      "Next": "AwaitApproval"
    },
    "AwaitApproval": {
      "Type": "Task",
      "Resource": "service-line:approval.wait",
      "ResultPath": "$.approval",
      "Next": "ApprovalDecision"
    },
    "ApprovalDecision": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.approval.decision",
          "StringEquals": "approved",
          "Next": "Implement"
        },
        {
          "Variable": "$.approval.decision",
          "StringEquals": "revise",
          "Next": "Plan"
        }
      ],
      "Default": "Cancelled"
    },
    "Implement": {
      "Type": "Task",
      "Resource": "service-line:agent.implement",
      "ResultPath": "$.implementation",
      "TimeoutSeconds": 1800,
      "Next": "RunChecks"
    },
    "RunChecks": {
      "Comment": "Runs the checks the service guide requires for the approved risk level.",
      "Type": "Task",
      "Resource": "service-line:checks.run",
      "ResultPath": "$.checks",
      "Next": "Review"
    },
    "Review": {
      "Type": "Task",
      "Resource": "service-line:agent.verify",
      "ResultPath": "$.review",
      "Next": "Evaluate"
    },
    "Evaluate": {
      "Comment": "Requires the human review assigned to the approved risk level before a pass.",
      "Type": "Task",
      "Resource": "service-line:verification.evaluate",
      "ResultPath": "$.verification",
      "Next": "Route"
    },
    "Route": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.verification.verdict",
          "StringEquals": "passed",
          "Next": "Ready"
        },
        {
          "And": [
            {
              "Variable": "$.verification.verdict",
              "StringEquals": "failed"
            },
            {
              "Variable": "$.repairs",
              "NumericLessThan": 2
            }
          ],
          "Next": "Repair"
        }
      ],
      "Default": "NeedsAttention"
    },
    "Repair": {
      "Type": "Task",
      "Resource": "service-line:repair.run",
      "ResultPath": "$",
      "TimeoutSeconds": 1800,
      "Next": "RunChecks"
    },
    "Ready": {
      "Comment": "Ready for review. After a recorded deployment, post-deploy-observe can start as a second run.",
      "Type": "Succeed"
    },
    "NeedsAttention": {
      "Type": "Fail",
      "Error": "VerificationNeedsAttention",
      "Cause": "Required evidence is missing, inconclusive, or the repair limit is reached."
    },
    "Cancelled": {
      "Type": "Fail",
      "Error": "PlanNotApproved",
      "Cause": "Implementation requires an approved plan."
    }
  }
}
